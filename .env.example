# API Configuration
VITE_OMBOR_API_BASE_URL=http://localhost:5062

# ── Telemetry (docs/observability-analytics-plan.md) ─────────────────────────
# Production-only by policy: these stay EMPTY in dev / previews (telemetry
# no-ops without them) and are set in the Netlify Production deploy context.

# Sentry — errors, performance tracing, session replay
VITE_OMBOR_SENTRY_DSN=

# PostHog — product analytics (replay/error capture stay off; Sentry owns them)
VITE_OMBOR_POSTHOG_KEY=
VITE_OMBOR_POSTHOG_HOST=https://us.i.posthog.com

# Environment tag on every event ("production" on Netlify)
VITE_OMBOR_ENVIRONMENT=

# Build-only secrets (NOT VITE_-prefixed, never shipped to the client) live in
# Netlify env vars, not in .env files: SENTRY_AUTH_TOKEN, SENTRY_ORG,
# SENTRY_PROJECT, SENTRY_URL — used by the source-map upload during `vite build`.

# Mock layer (MSW) — "true" enables src/mocks (see docs/mocking.md); "false" hits the real backend
VITE_ENABLE_MOCKS=false
